# ---------------------------------------------------------------------------
# DataAgent ProMax 环境变量示例
#
# 复制为 .env 后填写，.env 已被 .gitignore 忽略，不要提交。
# 注意：Spring Boot 不会自动读取 .env。docker compose 读取 docker-file/ 下的 .env；
# 本地启动后端请通过 shell export、IDE Run Configuration 或 -D 参数注入。
# ---------------------------------------------------------------------------

# ---- DataAgent 业务库（Agent 自身的元数据库，不是被分析的数据源） ----
DATA_AGENT_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/saa_data_agent?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai
DATA_AGENT_DATASOURCE_USERNAME=root
DATA_AGENT_DATASOURCE_PASSWORD=
# always / never；首次启动需要建表时设为 always
DATA_AGENT_DATASOURCE_SQL_INIT=never

# ---- Elasticsearch 向量库（profile: elasticsearch） ----
ELASTICSEARCH_URIS=http://127.0.0.1:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_NAME=spring-ai-document-index
ELASTICSEARCH_DIMENSIONS=1024
ELASTICSEARCH_INITIALIZE_SCHEMA=true

# ---- 模型服务 ----
# docker compose 透传给后端
AI_DASHSCOPE_API_KEY=
# 仅 live-model 测试使用
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DATAAGENT_LIVE_DEEPSEEK_API_KEY=
DATAAGENT_LIVE_DASHSCOPE_API_KEY=

# ---- 文件存储（可选，默认本地磁盘） ----
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET_NAME=
OSS_CUSTOM_DOMAIN=

# ---- Langfuse 可观测性（可选） ----
LANGFUSE_ENABLED=false
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- 离线评测 ----
# 评测数据库密码；不设置时回退到 benchmark.db.password（默认 root）
BENCHMARK_DB_PASSWORD=
# OpenAI 兼容对话服务密钥；也可用 -Dbenchmark.chat.api-key 传入
BENCHMARK_CHAT_API_KEY=
